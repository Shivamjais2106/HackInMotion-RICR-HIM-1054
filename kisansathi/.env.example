# KisanSathi Environment Variable Template (.env.example)

# Application Environment
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000

# Security Keys
SECRET_KEY=kisansathi_secret_key_change_in_production
JWT_SECRET_KEY=kisansathi_jwt_secret_change_in_production

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=kisansathi

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=True

# External API Integrations
OPENWEATHER_API_KEY=your_openweather_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
